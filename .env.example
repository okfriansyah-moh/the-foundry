# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# --- tools/planrunner (Task 3 / RUN-01) ---
# Disposable bootstrap Telegram bot token used only by the plan runner to gate/report on
# building Foundry itself. This is explicitly throwaway: rotate or delete it freely, and
# never point it at the same bot Foundry's eventual production Telegram engine (Task 30)
# will use.
TELEGRAM_BOT_TOKEN=
# Chat ID the bootstrap bot posts to and reads /approve, /reject, /freeze commands from.
TELEGRAM_CHAT_ID=

# --- Runtime services (Task 4 / SKP-02) ---
# Postgres DSN, reachable from `dev` by service name over the compose network.
PG_DSN=postgres://foundry:foundry@postgres:5432/foundry?sslmode=disable
# Temporal frontend gRPC address, reachable from `dev` by service name.
TEMPORAL_HOSTPORT=temporal:7233
# Foundry's local data directory, bind-mounted inside the `dev` workspace.
FOUNDRY_DATA_DIR=/workspace/.data

# --- Strong-auth identity provider (Task 114 / INT-06) ---
# The IdP is configuration, not code. `foundry login`'s OIDC device-code flow
# (internal/authn/oidc.go) needs an issuer and a client id; WebAuthn itself is
# Foundry-side, so this governs OIDC identity only. Default to a hosted,
# Zitadel-class free tier (no container, no new image lineage — self-hosting is
# reachable by changing the issuer URL alone). CI uses test/fakes/oidc instead.
FOUNDRY_OIDC_ISSUER=https://your-instance.zitadel.cloud
FOUNDRY_OIDC_CLIENT_ID=
# Space-separated scope set requested at login. `openid` is required; `profile`
# and `email` bind a human-readable approver identity onto the ApprovedPlan.
FOUNDRY_OIDC_SCOPES=openid profile email
# WebAuthn relying-party origin; setting it enables strong auth and the
# FOUNDRY_OIDC_* startup check (foundryd refuses to start half-configured).
FOUNDRY_WEBAUTHN_RPID=localhost
FOUNDRY_WEBAUTHN_ORIGIN=http://localhost:8081
# foundryd's production Telegram bot (distinct from the disposable planrunner bot
# above) and the ops chat/principal the inbound CommandRouter binds (Task 112).
FOUNDRY_TELEGRAM_BOT_TOKEN=
FOUNDRY_OPS_CHAT_ID=
FOUNDRY_OPS_PRINCIPAL=ops

# --- SCM write tokens (Tasks 27 / 137) ---
# Least-privilege tokens for kernel-owned branch pushes only (no PR/admin
# scopes). Never grant these to the executor sandbox — SCM writes are C4
# kernel side effects.
GITHUB_TOKEN=
BITBUCKET_API_TOKEN=
# Gated live Bitbucket write proof (Task 137): disposable repo only.
# SCM_WRITE_TEST_BITBUCKET_REPO_URL=
# SCM_WRITE_TEST_BITBUCKET_BASE_BRANCH=
