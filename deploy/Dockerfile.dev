# Multi-stage `dev` toolchain (docs/PLAN.md Task 1).
# Stage `tools` builds CLI binaries only; the final stage never bakes
# /go/pkg/mod, GOTOOLCHAIN SDKs, or npm caches into the shipped image —
# Compose mounts named volumes over module/build caches at runtime.

# ---------------------------------------------------------------------------
# tools: go install → /out/bin (discard module/toolchain caches with the stage)
# ---------------------------------------------------------------------------
FROM golang:1.25.7 AS tools

# Go tooling (GOTOOLCHAIN=auto lets `go install` fetch a newer toolchain
# on demand when a tool's go.mod requires one newer than the base image).
# goreleaser@latest still needs GOTOOLCHAIN=go1.24.10 pinned: its transitive
# golang.org/x/tools@v0.21.0 dependency fails to compile under go1.25.x
# ("invalid array length -delta * delta"). golangci-lint has no such issue
# and must NOT be pinned this way: doing so makes the installed binary
# self-report "built with go1.24", which then refuses to lint this repo's
# go.mod (`go 1.25.7`) — "can't load config: the Go language version
# (go1.24) used to build golangci-lint is lower than the targeted Go
# version (1.25.7)".
ENV GOTOOLCHAIN=auto
ENV GOBIN=/out/bin
RUN mkdir -p /out/bin \
    && go install github.com/pressly/goose/v3/cmd/goose@latest \
    && GOTOOLCHAIN=go1.24.10 go install github.com/goreleaser/goreleaser@latest \
    && go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest \
    && go install github.com/okfriansyah-moh/ares/cmd/ars@latest \
    && rm -rf /go/pkg/mod /root/.cache /root/go/pkg /usr/local/go/pkg/mod

# ---------------------------------------------------------------------------
# final `dev` image: apt toolchain + copied binaries (no go-install caches)
# ---------------------------------------------------------------------------
FROM golang:1.25.7

ARG USER_UID=1000
ARG USER_GID=1000
# Playwright Chromium OS deps are optional — default off to keep the image lean.
# Product / UI e2e: WITH_PLAYWRIGHT_DEPS=1 make bootstrap
ARG WITH_PLAYWRIGHT_DEPS=0

# Base packages + Node.js (NodeSource keyring, not curl|bash) + Docker CLI.
# python3 omitted (unused by repo scripts). Playwright deps gated below.
RUN apt-get update && apt-get dist-upgrade -y && apt-get install -y --no-install-recommends \
    make \
    git \
    ca-certificates \
    curl \
    gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && chmod 644 /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
      > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# PostgreSQL client tools pinned to major version 16 to match
# deploy/docker-compose.yaml's `postgres:16` server (docs/notes/
# m1-exit-report.md's documented client/server skew: this base image's
# Debian trixie main repo only carries the unversioned `postgresql-client`
# metapackage, which resolves to v17 — mismatched with the pinned v16
# server). PGDG's own apt repo is required because trixie's main repo does
# not carry postgresql-client-16 at all.
RUN install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*

# Optional Playwright Chromium system dependencies (Tasks 46/48 product UI).
RUN if [ "${WITH_PLAYWRIGHT_DEPS}" = "1" ]; then \
      npx --yes playwright@1.45.0 install-deps chromium \
      && rm -rf /root/.npm /tmp/*; \
    fi

COPY --from=tools /out/bin/goose /out/bin/goreleaser /out/bin/golangci-lint /out/bin/ars /usr/local/bin/

# Non-root user with host-matching UID/GID so bind-mounted files keep sane ownership
RUN groupadd --gid ${USER_GID} foundry \
    && useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash foundry

# `useradd --create-home` sets /home/foundry as this account's home
# directory in /etc/passwd, but that alone does not make $HOME resolve
# there for a bare (non-login-shell) command run as this user — confirmed
# live in CI: `make lint` failed with "failed to initialize build cache at
# /home/foundry/.cache/golangci-lint: mkdir ...: permission denied",
# because golangci-lint derives its own cache path from $HOME at runtime,
# and an unset/wrong $HOME sends it somewhere this user can't write (e.g.
# filesystem root). Setting HOME explicitly removes that ambiguity for
# every tool that looks it up, not just golangci-lint.
ENV HOME=/home/foundry

# Module/build caches are NOT populated in this image (tools stage discards
# them). Compose mounts named volumes at /go/pkg/mod and GOCACHE; seed empty
# dirs owned by foundry so the first volume init is writable by the non-root
# user (same ownership failure mode documented historically when root-owned
# /go/pkg/mod was copied into a fresh volume).
ENV GOCACHE=/home/foundry/.cache/go-build
# Chowns /home/foundry/.cache itself, not just the GOCACHE leaf directory
# below it — `mkdir -p` (still running as root here) creates every missing
# path component owned by root, and an earlier version of this line only
# chowned GOCACHE's own leaf, leaving its parent .cache/ still root-owned.
# That went unnoticed until a real CI run showed a DIFFERENT tool
# (golangci-lint, which keeps its own cache at .cache/golangci-lint,
# alongside go-build rather than under it) failing to `mkdir` its own new
# sibling directory there — foundry could write inside the already-chowned
# go-build leaf, but not create a new entry in its still-root-owned parent.
RUN mkdir -p /go/pkg/mod "${GOCACHE}" \
    && chown -R ${USER_UID}:${USER_GID} /go /home/foundry/.cache

USER foundry
WORKDIR /workspace

# /workspace is a bind mount of the host's checkout — on a real Linux CI
# runner (unlike macOS Docker Desktop's bind-mount layer, which silently
# normalizes this), it's owned by whatever UID checked it out on the host,
# not this container's own `foundry` UID. Git 2.35+'s "dubious ownership"
# safety check refuses to operate on a repo owned by a different UID than
# the one running it — and `go build`/`go vet`/etc.'s own VCS-stamping
# machinery shells out to `git status` internally, so without this, any
# such command fails with "error obtaining VCS status: exit status 128"
# before ever reaching its own real work. Scoped to this one path (not a
# blanket `*`) since /workspace is always what this image's own
# docker-compose.yaml mounts here, never an arbitrary/untrusted repo.
RUN git config --global --add safe.directory /workspace
